{
  "name": "@n10/desktop-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "desktop-e2e",
    "tags": [
      "type:app",
      "scope:desktop-e2e"
    ],
    "implicitDependencies": [
      "desktop"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "desktop"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "@playwright/test",
              "electron"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/playwright/output",
          "{projectRoot}/test-output/playwright/report"
        ],
        "options": {
          "command": "node run-e2e.mjs",
          "cwd": "apps/desktop-e2e"
        }
      },
      "e2e:visual": {
        "executor": "nx:run-commands",
        "cache": true,
        "dependsOn": [
          {
            "projects": [
              "desktop"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "@playwright/test",
              "electron"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/test-output/playwright/output"
        ],
        "options": {
          "command": "node run-visual.mjs",
          "cwd": "apps/desktop-e2e"
        }
      },
      "perf": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "desktop"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node run-perf.mjs",
          "cwd": "apps/desktop-e2e"
        }
      },
      "e2e:integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          {
            "projects": [
              "desktop"
            ],
            "target": "build"
          }
        ],
        "options": {
          "command": "node run-e2e.mjs --grep @integration",
          "cwd": "apps/desktop-e2e"
        }
      },
      "check-bridge-mirror": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/src/n10-window.d.ts",
          "{projectRoot}/scripts/check-bridge-mirror.mjs",
          "{workspaceRoot}/apps/desktop/src/host/contract.ts",
          "{workspaceRoot}/apps/desktop/src/host/contract-terminals.ts"
        ],
        "options": {
          "command": "node scripts/check-bridge-mirror.mjs",
          "cwd": "apps/desktop-e2e"
        }
      },
      "typecheck": {
        "dependsOn": [
          "check-bridge-mirror"
        ]
      }
    }
  }
}
