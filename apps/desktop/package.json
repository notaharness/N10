{
  "name": "n10-desktop",
  "version": "1.0.0-beta.7",
  "description": "n10 Desktop — GUI shell over the same app core as the n10 TUI",
  "author": "Hermann Bjorgvin",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notaharness/n10.git",
    "directory": "apps/desktop"
  },
  "nx": {
    "name": "desktop",
    "tags": [
      "type:app",
      "scope:desktop"
    ],
    "targets": {
      "build-main": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/desktop/dist/main",
          "format": [
            "esm"
          ],
          "bundle": true,
          "thirdParty": true,
          "external": [
            "electron",
            "node-pty"
          ],
          "main": "apps/desktop/src/main/main.ts",
          "tsConfig": "apps/desktop/tsconfig.build.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "banner": {
              "js": "import { createRequire as __n10CreateRequire } from \"node:module\";const require = __n10CreateRequire(import.meta.url);"
            }
          },
          "additionalEntryPoints": [
            "apps/desktop/src/main/tmux-session-worker.ts",
            "apps/desktop/src/main/beam-node-worker.ts"
          ]
        },
        "configurations": {
          "development": {
            "esbuildOptions": {
              "banner": {
                "js": "import { createRequire as __n10CreateRequire } from \"node:module\";const require = __n10CreateRequire(import.meta.url);"
              }
            }
          },
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "banner": {
                "js": "import { createRequire as __n10CreateRequire } from \"node:module\";const require = __n10CreateRequire(import.meta.url);"
              }
            }
          }
        }
      },
      "build-preload": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/desktop/dist/preload",
          "format": [
            "cjs"
          ],
          "bundle": true,
          "thirdParty": true,
          "external": [
            "electron"
          ],
          "main": "apps/desktop/src/preload/preload.ts",
          "tsConfig": "apps/desktop/tsconfig.build.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".cjs"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false
            }
          }
        }
      },
      "build-renderer": {
        "executor": "nx:run-commands",
        "outputs": [
          "{workspaceRoot}/apps/desktop/dist/renderer"
        ],
        "options": {
          "command": "npx vite build",
          "cwd": "apps/desktop"
        }
      },
      "build": {
        "executor": "nx:noop",
        "dependsOn": [
          "build-main",
          "build-preload",
          "build-renderer"
        ]
      },
      "serve": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "node apps/desktop/scripts/dev.mjs",
          "cwd": "{workspaceRoot}"
        }
      },
      "prepare-install": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "node apps/desktop/scripts/prepare-install.mjs"
        }
      },
      "install-global": {
        "dependsOn": [
          "prepare-install"
        ],
        "executor": "nx:run-commands",
        "options": {
          "command": "chmod +x apps/desktop/dist/launcher.mjs && npm install -f ./apps/desktop/dist/*n10-desktop-*.tgz"
        }
      },
      "publish": {
        "dependsOn": [
          "prepare-install"
        ],
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "chmod +x apps/desktop/dist/launcher.mjs",
            "npm publish --tag beta apps/desktop/dist",
            "node scripts/dist-tag-latest.mjs @notaharness/n10-desktop"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@n10/app-core": "*",
    "@n10/beam": "*",
    "@n10/core": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@wterm/dom": "0.3.4",
    "@wterm/react": "0.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^39.2.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.11"
  },
  "main": "dist/main/main.js"
}
