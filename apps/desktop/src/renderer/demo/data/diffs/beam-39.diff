 th { font-weight: 600; width: 34%; }
 footer { padding: 1.5rem 0 2rem; border-top: 1px solid var(--rule); font-size: 0.875rem; color: var(--muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
-footer a { color: inherit; }
+a { color: inherit; }
+.scene { display: block; width: 100%; height: auto; margin: 0.5rem 0 1.5rem; }
+.scene .machine { fill: var(--bg); stroke: var(--fg); stroke-width: 2; stroke-linejoin: round; }
+.scene .part { fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; }
+.scene .lane { stroke: var(--beam); stroke-width: 2; }
+.scene .packet { stroke: var(--packet); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 6 94; stroke-dashoffset: -47; }
+@media (prefers-reduced-motion: no-preference) {
+  .scene .packet { animation: beam 2.4s linear infinite; }
