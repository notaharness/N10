vitest.config.*.timestamp*
tui-traces/
.tui-test/
test-output
test-results
playwright-report

# Benchmark samples (apps/desktop-e2e/perf). Numbers from one machine
# on one day; the harness that produces them is what is shared.
perf-output

# Playwright MCP browser session output (manual interactive QA)
.playwright-mcp/

# Next.js / Fumadocs (apps/website). next-env.d.ts is regenerated
# deterministically by `next dev`/`build`/`typegen` and, if committed,
# matches `*.{ts,tsx}` in lint-staged and trips ESLint's
# "file ignored by pattern" warning at --max-warnings 0.
.next
out
.source
.open-next
.wrangler
next-env.d.ts
apps/website/src/generated
# The desktop renderer built for the landing demo (desktop:build-demo),
# copied in by website:sync-demo.
apps/website/public/desktop-demo

# Intermediate recordings from the README capture script. The published
# GIFs and stills in docs/media/ are committed; the multi-megabyte
# lossless captures they are made from are not.
docs/media/raw

# Personal agent instructions
CLAUDE.local.md
